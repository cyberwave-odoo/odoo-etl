<odoo> 
    <record id="view_etl_list" model="ir.ui.view">
        <field name="name">etl.model.list</field>
        <field name="model">etl.model</field>
        <field name="arch" type="xml">
            <tree string="ETL Models">
                <field name="name"/>
                <field name="odoo_name" />
                <field name="unique_identifier_tuple" />
                <field name="elapsed_time_import" />
                <field name="last_import" />
                <field name="total_imported_rec"/>
                <field name="updated_imported_rec"/>
                <field name="new_imported_rec" />
                <field name="dbsource_id" />
                <field name="dry_run" />
                <button name="call_model_import" type="object" string="Import Records" class="oe_highlight"/>
                <button name="call_model_export" type="object" string="Export Records" class="oe_highlight"/>
            </tree>
        </field>
    </record>

    <record id="view_etl_form" model="ir.ui.view">
        <field name="name">etl.model.form</field>
        <field name="model">etl.model</field>
        <field name="arch" type="xml">
            <form string="ETL Model">
                <header>
                    <button name="call_model_import" type="object" string="Import Records" class="oe_highlight"/>
                    <button name="call_model_export" type="object" string="Export Records" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group >
                            <field name="name"/>
                            <field name="odoo_name"/>
                            <field name="dbsource_id"/>
                            <field name="enabled"/>
                        </group>
                        <group>
                            <field name="dry_run"/>
                            <field name="bulk_import"/>
                            <field name="custom_import"/>
                            <field name="pre_exec"/>
                        </group>
                        
                        <field name="arguments" />
                    </group>
                    <group string="Conditions">
                        <field name="unique_identifier_tuple"/>
                        <field name="remove_condition"/>
                    </group>
                    <notebook>
                        <page string="Mappings">
                            <field name="field_mapping" />
                            
                        </page>
                        <page string="Import / Export Info">
                            <group>
                                <field name="last_import"/>
                                <field name="elapsed_time_import"/>
                                <field name="total_imported_rec"/>
                                <field name="new_imported_rec"/>
                                <field name="updated_imported_rec"/>
                            </group>
                            <group>
                                <field name="last_export"/>
                                <field name="elapsed_time_export"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_etl_model" model="ir.actions.act_window">
        <field name="name">Default ETL Models Action</field>
        <field name="res_model">etl.model</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_order': 'name'}</field>
    </record>


    
    
</odoo>