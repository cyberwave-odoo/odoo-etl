<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- SQLite Database Source -->
        <record model="base.external.dbsource" id="demo_sqlite">
            <field name="name">Demo SQLite</field>
            <field name="conn_string">sqlite:///odoo-etl/odoo_etl_example/db/db/customers.db</field>
            <field name="password" />
            <field name="connector">sqlite</field>
        </record>

        <!-- ETL Configuration for Customers -->
        <record model="etl.model" id="demo_customers_etl">
            <field name="name">customers</field>
            <field name="odoo_name">res.partner</field>
            <field name="field_mapping">{
                'name': {
                    'type': 'lambda',
                    'function': lambda self, record, **kwargs: f"{record['first_name']} {record['last_name']}"
                },
                'email': {
                    'type': 'column',
                    'column_name': 'email_address'
                },
                'country_id': {
                    'type': 'join',
                    'lookup_table': 'res.country',
                    'left_on': 'country',
                    'right_on': 'name'
                }
            }</field>
            <field name="unique_identifier_tuple">('email', 'email_address')</field>
            <field name="dbsource_id" ref="demo_sqlite"/>
        </record>
    </data>
</odoo> 